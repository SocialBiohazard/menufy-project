# Runtime database connection (Supabase transaction pooler in production).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Migration connection (Supabase direct connection or session pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="your-server-secret"

# Main operator application URL. Customer hostnames are configured per restaurant.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated, case-insensitive dashboard allowlist.
OPERATOR_EMAILS="developer@example.com"
