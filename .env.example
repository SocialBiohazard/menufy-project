# Runtime PostgreSQL connection. On Railway, reference the Postgres service's
# private DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/railway"

# Migration connection. This may match DATABASE_URL when the provider exposes a
# normal direct connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/railway"

# Media storage. Use "local" only for local development. Railway production
# should use "s3" and inject the bucket credentials below.
MEDIA_STORAGE_DRIVER="local"
AWS_ENDPOINT_URL="https://storage.railway.app"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""
AWS_DEFAULT_REGION="auto"
AWS_S3_URL_STYLE="virtual"

# Main operator application URL. Customer hostnames are configured per restaurant.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Comma-separated, case-insensitive dashboard allowlist.
OPERATOR_EMAILS="developer@example.com"
