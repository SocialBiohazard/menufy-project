// MenuApp schema — Part 2 §2 data model.
// One premium template rendered per restaurant; visual identity is driven by
// the `theme*` palette fields below (they map 1:1 to the reference platform's
// --menu-* CSS variables discovered in reference/captures/*/dom.html).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  // Prisma 7: connection URLs are NOT set here. Migrate/CLI reads the URL from
  // prisma.config.ts (DIRECT_URL); the runtime PrismaClient uses a driver
  // adapter with the pooled DATABASE_URL (see lib/prisma).
  provider = "postgresql"
}

enum NavigationStyle {
  DRILLDOWN
  ACCORDION
}

enum PortionUnit {
  G
  ML
  L
}

enum CustomerRole {
  OWNER
  EDITOR
  VIEWER
}

enum CustomerPlan {
  TRIAL
  BASIC
  PRO
}

enum AuditActorType {
  OPERATOR
  CUSTOMER
  SYSTEM
}

model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique
  businessName String
  businessType String?

  // --- Phase 1.5 queue: nullable, not built into MVP UI yet ---
  phone               String?
  email               String?
  whatsappNumber      String?
  websiteUrl          String?
  address             String?
  city                String?
  district            String?
  workingHours        Json?
  timezone            String  @default("Europe/Istanbul")
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  xUrl                String?
  youtubeUrl          String?
  googleMapsUrl       String?
  googleReviewsUrl    String?
  kdvNotice           String?
  kdvNoticeEn         String?
  kdvNoticeAr         String?
  kdvNoticeRu         String?
  kdvNoticeDe         String?
  kdvNoticeFr         String?
  kdvNoticeEs         String?
  kdvNoticeIt         String?
  kdvNoticePl         String?
  kdvNoticeZh         String?
  allergenNotice      String?
  allergenNoticeEn    String?
  allergenNoticeAr    String?
  allergenNoticeRu    String?
  allergenNoticeDe    String?
  allergenNoticeFr    String?
  allergenNoticeEs    String?
  allergenNoticeIt    String?
  allergenNoticePl    String?
  allergenNoticeZh    String?
  nutritionNotice     String?
  nutritionNoticeEn   String?
  nutritionNoticeAr   String?
  nutritionNoticeRu   String?
  nutritionNoticeDe   String?
  nutritionNoticeFr   String?
  nutritionNoticeEs   String?
  nutritionNoticeIt   String?
  nutritionNoticePl   String?
  nutritionNoticeZh   String?
  slogan              String?
  sloganEn            String?
  sloganAr            String?
  sloganRu            String?
  sloganDe            String?
  sloganFr            String?
  sloganEs            String?
  sloganIt            String?
  sloganPl            String?
  sloganZh            String?
  footerDescription   String?
  footerDescriptionEn String?
  footerDescriptionAr String?
  footerDescriptionRu String?
  footerDescriptionDe String?
  footerDescriptionFr String?
  footerDescriptionEs String?
  footerDescriptionIt String?
  footerDescriptionPl String?
  footerDescriptionZh String?
  footerCopyright     String?
  footerVisibility    Json?
  establishedYear     Int?
  currencyCode        String  @default("TRY")
  attributionText     String?
  attributionUrl      String?
  // ------------------------------------------------------------

  logo          String?
  coverImage    String?
  splashImage   String?
  splashEnabled Boolean @default(false)

  // Optional custom host such as menu.example.com. The application still
  // keeps /[slug] available as an operator preview/fallback URL.
  publicHostname    String?   @unique
  lastPriceChangeAt DateTime?

  templateType String // key into the code-level template registry

  // Palette knobs — the whole theming system. Map to --menu-* CSS variables.
  themeAccent     String? // --menu-accent
  themePrimary    String? // --menu-primary
  themeSecondary  String? // --menu-secondary
  themeBackground String? // --menu-background
  themeBorder     String? // --menu-border
  themeText       String? // --menu-text

  categoryNavigationStyle NavigationStyle @default(DRILLDOWN)
  darkMode                Boolean         @default(true)

  defaultLang  String   @default("tr")
  enabledLangs String[] @default(["tr", "en", "ar"])

  isPublished       Boolean   @default(false)
  publishedSnapshot Json?
  publishedAt       DateTime?
  draftUpdatedAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customerAccountId   String?
  customerAccount     CustomerAccount?       @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  categories          Category[]
  menuSchedules       MenuSchedule[]
  customerMemberships RestaurantMembership[]
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@index([customerAccountId])
}

model Operator {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      OperatorSession[]
  notifications Notification[]
}

model OperatorSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([operatorId])
  @@index([expiresAt])
}

model CustomerAccount {
  id              String       @id @default(cuid())
  name            String
  plan            CustomerPlan @default(TRIAL)
  maxRestaurants  Int          @default(1)
  maxStorageBytes BigInt       @default(1073741824)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  users       CustomerUser[]
  restaurants Restaurant[]
  invitations CustomerInvitation[]
}

model CustomerUser {
  id           String          @id @default(cuid())
  accountId    String
  account      CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email        String          @unique
  name         String?
  passwordHash String
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  sessions        CustomerSession[]
  memberships     RestaurantMembership[]
  notifications   Notification[]
  sentInvitations CustomerInvitation[]   @relation("CustomerInviter")

  @@index([accountId])
}

model CustomerSession {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@index([customerUserId])
  @@index([expiresAt])
}

model RestaurantMembership {
  id             String       @id @default(cuid())
  customerUserId String
  customerUser   CustomerUser @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  restaurantId   String
  restaurant     Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  role           CustomerRole
  createdAt      DateTime     @default(now())

  @@unique([customerUserId, restaurantId])
  @@index([restaurantId])
}

model CustomerInvitation {
  id                      String          @id @default(cuid())
  tokenHash               String          @unique
  email                   String
  role                    CustomerRole
  restaurantIds           String[]
  customerAccountId       String
  customerAccount         CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  invitedByCustomerUserId String?
  invitedByCustomerUser   CustomerUser?   @relation("CustomerInviter", fields: [invitedByCustomerUserId], references: [id], onDelete: SetNull)
  expiresAt               DateTime
  acceptedAt              DateTime?
  createdAt               DateTime        @default(now())

  @@index([customerAccountId])
  @@index([email])
}

model AuditLog {
  id           String         @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  actorType    AuditActorType
  actorId      String?
  actorEmail   String?
  action       String
  entityType   String
  entityId     String?
  changes      Json?
  createdAt    DateTime       @default(now())

  @@index([restaurantId, createdAt])
}

model Notification {
  id             String        @id @default(cuid())
  operatorId     String?
  operator       Operator?     @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  customerUserId String?
  customerUser   CustomerUser? @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  restaurantId   String?
  restaurant     Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  type           String
  title          String
  body           String?
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([operatorId, createdAt])
  @@index([customerUserId, createdAt])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name   String
  nameEn String?
  nameAr String?
  nameRu String?
  nameDe String?
  nameFr String?
  nameEs String?
  nameIt String?
  namePl String?
  nameZh String?

  imageUrl  String?
  sortOrder Int     @default(0)
  sortGroup String? // present, unused in MVP UI — deferred grouping feature

  items Item[]

  @@index([restaurantId])
}

model Item {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name          String
  nameEn        String?
  nameAr        String?
  nameRu        String?
  nameDe        String?
  nameFr        String?
  nameEs        String?
  nameIt        String?
  namePl        String?
  nameZh        String?
  description   String?
  descriptionEn String?
  descriptionAr String?
  descriptionRu String?
  descriptionDe String?
  descriptionFr String?
  descriptionEs String?
  descriptionIt String?
  descriptionPl String?
  descriptionZh String?

  price         Int // whole currency units (reference stores TRY as whole lira)
  portionAmount Float?
  portionUnit   PortionUnit?
  imageUrl      String?
  ingredients   String? // TR only, freeform

  isNew       Boolean @default(false)
  isFeatured  Boolean @default(false)
  isAvailable Boolean @default(true) // the "86" toggle
  hasAlcohol  Boolean @default(false)
  hasPork     Boolean @default(false)
  sortOrder   Int     @default(0)

  allergens ItemAllergen[]
  nutrition Nutrition?
  variants  Variant[] // schema stub — not exposed in MVP builder/diner UI

  @@index([categoryId])
}

model Allergen {
  id     Int            @id // 1–14, Turkish allergen regulation, pre-seeded
  nameTr String
  nameEn String
  nameAr String
  nameRu String?
  nameDe String?
  nameFr String?
  nameEs String?
  nameIt String?
  namePl String?
  nameZh String?
  icon   String // emoji
  items  ItemAllergen[]
}

model ItemAllergen {
  itemId     String
  allergenId Int
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@id([itemId, allergenId])
  @@index([allergenId])
}

model Nutrition {
  id     String @id @default(cuid())
  itemId String @unique
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  energyKcal   Int?
  protein      Float?
  fat          Float?
  saturatedFat Float?
  carbohydrate Float?
  sugar        Float?
  fiber        Float?
  saltG        Float?
  basis        String? // "100g" | "100ml" | "per portion"
  isEstimated  Boolean @default(false)
}

model Variant {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  label     String
  labelEn   String?
  labelAr   String?
  labelRu   String?
  labelDe   String?
  labelFr   String?
  labelEs   String?
  labelIt   String?
  labelPl   String?
  labelZh   String?
  price     Int
  sortOrder Int     @default(0)

  @@index([itemId])
}

model MenuSchedule {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String // e.g. "Breakfast", "Dinner"
  daysOfWeek  Int[] // 0–6
  startTime   String // "07:00"
  endTime     String // "11:00"
  categoryIds String[] // categories active during this window

  @@index([restaurantId])
}
